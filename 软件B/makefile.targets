# 命令行 make 时也生成链接脚本。MRS 里同一条命令写在 Pre-build。
LINK_GEN := ../Ld/Link_gen.ld
LINK_TPL := ../fw_app/00_System/System/linker.ld

CH32V203C8T6.elf: $(LINK_GEN)

$(LINK_GEN): $(LINK_TPL) ../fw_app/00_System/System/mem_map.h ../fw_app/00_System/System/config.h
	riscv-none-embed-gcc -E -P -x c -DMEM_LD=1 -I../fw_app/00_System/System $(LINK_TPL) -o $(LINK_GEN)
